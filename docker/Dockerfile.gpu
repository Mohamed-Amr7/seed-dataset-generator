# MultiSeedGen - GPU image (rembg on CUDA via onnxruntime-gpu).
#
# The CUDA runtime + cuDNN are installed as pip wheels (nvidia-*-cu12), exactly
# like the verified host setup, so this image does NOT need a CUDA base image -
# only the host NVIDIA driver, injected by the NVIDIA Container Toolkit at run
# time (see GPU_SETUP.md). onnxruntime.preload_dlls() loads the pip CUDA libs.
#
# Build:  docker build -f docker/Dockerfile.gpu -t multiseedgen:gpu .
# Run  :  see docker/compose.gpu.yaml  (requires --gpus / the toolkit)
#
# Base: python:3.12-slim, shared with Dockerfile.cpu/.sam so all images pull a single
# base layer. 3.12 has wheels for the whole GPU stack (onnxruntime-gpu 1.26.0 ships a
# cp312 wheel; the nvidia-*-cu12 wheels are python-agnostic) and matches the SAM image's
# torch ceiling, so there's no reason for the GPU image to diverge.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # rembg/U2Net model cache (mount a volume here to avoid re-downloading)
    U2NET_HOME=/models/u2net

# OpenCV runtime libs (headless still needs libGL/glib for some ops)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Build metadata + source (README is required: pyproject readme = "README.md").
COPY pyproject.toml README.md ./
COPY multiseedgen/ /app/multiseedgen/
COPY seedgen.py /app/seedgen.py

# DRY: install from the pyproject `gpu` + `web` extras (single source of truth).
# The `gpu` extra pins onnxruntime-gpu + the CUDA-12 pip wheels exactly like the
# verified host setup. NOTE: onnxruntime-gpu 1.27 links CUDA 13 (libcudart.so.13),
# and real CUDA-13 pip runtime wheels do not exist yet (only 0.0.1 stubs); 1.26.0
# links CUDA 12, which DOES have real cu12 wheels - ~4x faster than CPU, IoU 1.0 vs
# CPU masks. Pin lives in pyproject.toml ([gpu] extra) until cu13 wheels ship.
RUN pip install ".[gpu,web]"

# Sanity: confirm the CUDA EP is visible at build time (does not need the GPU).
RUN python -c "import onnxruntime as ort; print('ORT providers:', ort.get_available_providers())"

EXPOSE 8000
# Default: serve the Web UI. Override the command for CLI batch runs, e.g.
#   docker compose -f docker/compose.gpu.yaml run --rm multiseedgen \
#       python -m multiseedgen --sources /data/seeds --out /data/out --num-images 2000
CMD ["python", "-m", "multiseedgen.web", "--host", "0.0.0.0", "--port", "8000"]
