# Byte-compiled / caches
__pycache__/
*.py[cod]
*$py.class

# Test / type / lint tooling artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / tooling local state
.claude/
.DS_Store
.ipynb_checkpoints/

# Python envs / packaging
.venv/
venv/
env/
*.egg-info/

# Generated outputs
out/

# Large datasets and inputs (kept out of VCS; a small sample is force-added)
datasets/
seeds/
_uitest/

# Archives
*.zip

# Model checkpoints (large; downloaded on demand, e.g. SAM)
models/
*.pth

# Frontend (Node) — source lives in frontend/, build output is committed to
# multiseedgen/web/static/ (so pip/Docker need no Node). Only ignore Node's local state.
frontend/node_modules/
frontend/coverage/
frontend/.vite/
frontend/**/*.tsbuildinfo
