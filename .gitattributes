# The web UI is built from frontend/ (Vite) into this directory and committed so pip and
# Docker need no Node toolchain. Mark it generated: GitHub collapses these diffs by default
# and excludes them from language statistics. The editable source of truth is frontend/.
multiseedgen/web/static/** linguist-generated=true

# Lockfile is generated by npm.
frontend/package-lock.json linguist-generated=true
